{
  "name": "SauceDemo 生产场景（修复版）",
  "base_url": "https://www.saucedemo.com",
  "input_contract": [
    {"key": "username", "value": "standard_user"},
    {"key": "password", "value": "secret_sauce"}
  ],
  "steps": [
    {"action": "goto", "value": "https://www.saucedemo.com"},
    {"action": "input", "target": "textbox=Username", "value": "${username}"},
    {"action": "input", "target": "textbox=Password", "value": "${password}"},
    {"action": "click", "target": "button=Login"},
    {"action": "click", "target": "button=Add to cart", "scope": "Sauce Labs Backpack"},
    {"action": "click", "target": "css=.shopping_cart_link"},
    {"action": "wait_for", "target": "Your Cart"},
    {"action": "assert_text", "value": "Sauce Labs Backpack"}
  ]
}
